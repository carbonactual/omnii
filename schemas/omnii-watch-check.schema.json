{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omnii://schemas/watch-check/v1",
  "title": "OMNII Watch Check Contract",
  "description": "Reusable implementation contract for observing conditions over canonical objects and producing governed findings through existing Event, Evidence, State, Policy, Authority and Lifecycle semantics. This is not a new canonical object primitive.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "subject", "condition", "trigger", "severity", "authority", "evidence", "response"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "subject": {"type": "object", "additionalProperties": true},
    "condition": {"type": "object", "additionalProperties": true},
    "trigger": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["event", "schedule", "state-change", "threshold", "dependency-change", "manual"]},
        "cadence": {"type": ["string", "null"]}
      }
    },
    "severity": {"type": "string", "enum": ["info", "notice", "warning", "high", "critical"]},
    "authority": {"type": "object", "additionalProperties": true},
    "evidence": {"type": "object", "additionalProperties": true},
    "response": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["observe", "notify", "recommend", "confirm", "authorize", "block", "escalate"]}
      }
    },
    "policy": {"type": "object", "additionalProperties": true},
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "provenance": {"type": "object", "additionalProperties": true},
    "lifecycle": {"type": "object", "additionalProperties": true},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
