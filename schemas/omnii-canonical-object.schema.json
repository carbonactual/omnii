{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omnii://schemas/canonical-object/v2",
  "title": "OMNII Canonical Object",
  "description": "Provider-neutral canonical object envelope for the Universal Digital Common Layer.",
  "type": "object",
  "required": ["id","type","version","status","identity","provenance","authority","attributes","relationships","dependencies","capabilities","resources","timestamps"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "type": {"type":"string","minLength":1},
    "version": {"type":"string","minLength":1},
    "status": {"type":"string","minLength":1},
    "state": {"$ref":"#/$defs/state"},
    "identity": {"$ref":"#/$defs/identity"},
    "provenance": {"$ref":"#/$defs/provenance"},
    "authority": {"$ref":"#/$defs/authority"},
    "attributes": {"type":"object"},
    "relationships": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "capabilities": {"type":"array","items":{"type":"string"}},
    "resources": {"type":"array","items":{"type":"string"}},
    "intent": {"type":"object"},
    "policy": {"type":"object"},
    "trust": {"type":"object"},
    "evidence": {"type":"array","items":{"type":"string"}},
    "events": {"type":"array","items":{"type":"string"}},
    "continuity": {"$ref":"#/$defs/continuity"},
    "portability": {"$ref":"#/$defs/portability"},
    "settlement": {"type":"object"},
    "liability": {"type":"object"},
    "lifecycle": {"$ref":"#/$defs/lifecycle"},
    "timestamps": {"type":"object"},
    "metadata": {"type":"object"}
  },
  "$defs": {
    "identity": {
      "type":"object",
      "required":["canonical_id"],
      "properties":{
        "canonical_id":{"type":"string","minLength":1},
        "aliases":{"type":"array","items":{"type":"string"}},
        "external_identifiers":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":true
    },
    "authority": {
      "type":"object",
      "properties":{
        "principal":{"type":"string"},
        "grants":{"type":"array","items":{"type":"string"}},
        "delegation_chain":{"type":"array","items":{"type":"string"}},
        "scope":{"type":"array","items":{"type":"string"}},
        "revocation":{"type":"object"}
      },
      "additionalProperties":true
    },
    "state": {
      "type":"object",
      "required":["name"],
      "properties":{
        "name":{"type":"string","minLength":1},
        "reason":{"type":"string"},
        "effective_at":{"type":"string"},
        "previous":{"type":"string"},
        "confidence":{"type":"number","minimum":0,"maximum":1}
      },
      "additionalProperties":true
    },
    "provenance": {
      "type":"object",
      "properties":{
        "source":{"type":"string"},
        "derived_from":{"type":"array","items":{"type":"string"}},
        "method":{"type":"string"},
        "observed_at":{"type":"string"}
      },
      "additionalProperties":true
    },
    "continuity": {
      "type":"object",
      "properties":{
        "canonical_object_id":{"type":"string"},
        "last_verified_state":{"type":"string"},
        "last_verified_at":{"type":"string"},
        "authority_context":{"type":"string"},
        "protected_evidence_refs":{"type":"array","items":{"type":"string"}},
        "critical_dependency_refs":{"type":"array","items":{"type":"string"}},
        "vault_refs":{"type":"array","items":{"type":"string"}},
        "event_refs":{"type":"array","items":{"type":"string"}},
        "recovery_path":{"type":"string"},
        "successor_or_replacement":{"type":"string"},
        "exit_handoff":{"type":"object"}
      },
      "additionalProperties":true
    },
    "portability": {
      "type":"object",
      "properties":{
        "portable":{"type":"boolean"},
        "semantic_contract":{"type":"string"},
        "identity_refs":{"type":"array","items":{"type":"string"}},
        "relationship_refs":{"type":"array","items":{"type":"string"}},
        "authority_refs":{"type":"array","items":{"type":"string"}},
        "dependency_refs":{"type":"array","items":{"type":"string"}},
        "evidence_refs":{"type":"array","items":{"type":"string"}},
        "handoff":{"type":"object"}
      },
      "additionalProperties":true
    },
    "lifecycle": {
      "type":"object",
      "properties":{
        "created":{"type":"string"},
        "updated":{"type":"string"},
        "expires":{"type":"string"},
        "successor":{"type":"string"},
        "replacement":{"type":"string"},
        "exit":{"type":"object"}
      },
      "additionalProperties":true
    }
  },
  "additionalProperties":true
}