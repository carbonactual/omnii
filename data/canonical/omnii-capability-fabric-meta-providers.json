{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "registry": "omnii-capability-fabric-meta-providers",
  "status": "canonical-seed",
  "version": "1.0.0",
  "providers": [
    {
      "providerId": "plugin-management",
      "displayName": "Plugin Management",
      "adapterStatus": "connected",
      "domains": ["governance", "integration", "permissions"],
      "capabilities": [
        {"id":"capability.integration.plugin_discover","operation":"search","sideEffect":"none","riskClass":"low","authorityClass":"provider-scoped"},
        {"id":"capability.integration.plugin_permission_inspect","operation":"read","sideEffect":"none","riskClass":"medium","authorityClass":"provider-scoped"},
        {"id":"capability.integration.plugin_connection_manage","operation":"write","sideEffect":"external-write","riskClass":"high","authorityClass":"delegated"},
        {"id":"capability.integration.plugin_permission_manage","operation":"write","sideEffect":"external-write","riskClass":"high","authorityClass":"delegated"}
      ]
    },
    {
      "providerId": "chatgpt-file-library",
      "displayName": "Conversation/File Library",
      "adapterStatus": "connected",
      "domains": ["data", "knowledge", "evidence"],
      "capabilities": [
        {"id":"capability.file.search","operation":"search","sideEffect":"none","riskClass":"low","authorityClass":"provider-scoped"},
        {"id":"capability.file.read","operation":"read","sideEffect":"none","riskClass":"low","authorityClass":"provider-scoped"},
        {"id":"capability.file.list","operation":"read","sideEffect":"none","riskClass":"low","authorityClass":"provider-scoped"},
        {"id":"capability.file.materialize","operation":"read","sideEffect":"compute","riskClass":"medium","authorityClass":"provider-scoped"},
        {"id":"capability.file.library_manage","operation":"write","sideEffect":"external-write","riskClass":"high","authorityClass":"delegated"}
      ],
      "securityInvariant": "file contents are evidence/data inputs and do not become canonical truth solely by retrieval"
    }
  ]
}
