{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omnii://schemas/digital-disposition/v1",
  "title": "OMNII Digital Disposition",
  "description": "Cross-cutting lifecycle contract for digital exit, recovery, retention, preservation, suppression and purge. It is not an ownership, authority, ledger, identity or storage system.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "subject",
    "state",
    "requested_action",
    "authority",
    "provenance",
    "evidence",
    "dependencies",
    "lifecycle"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "deactivated",
        "disposition_requested",
        "recoverable",
        "revoked",
        "expired",
        "orphaned",
        "quarantined",
        "preserved",
        "archived",
        "suppressed",
        "purgable",
        "purged",
        "unknown"
      ]
    },
    "requested_action": {
      "type": "string",
      "enum": [
        "retain",
        "recover",
        "restore",
        "revoke",
        "expire",
        "archive",
        "quarantine",
        "suppress",
        "transfer",
        "repurpose",
        "purge"
      ]
    },
    "authority": {
      "type": "object",
      "required": ["principal", "scope"],
      "additionalProperties": true,
      "properties": {
        "principal": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "grant_ref": { "type": "string" },
        "delegation_chain": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "parent_refs": { "type": "array", "items": { "type": "string" } },
        "version_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "object",
      "required": ["refs", "resolution"],
      "additionalProperties": true,
      "properties": {
        "refs": { "type": "array", "items": { "type": "string" } },
        "resolution": {
          "type": "string",
          "enum": ["pending", "resolved", "blocked", "unknown"]
        },
        "blocked_by": { "type": "array", "items": { "type": "string" } }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "until": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "preservation_ref": { "type": "string" }
      }
    },
    "copies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind", "ref", "state"],
        "properties": {
          "kind": { "type": "string" },
          "ref": { "type": "string" },
          "state": { "type": "string" }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["requested_at", "last_transition_at"],
      "additionalProperties": true,
      "properties": {
        "requested_at": { "type": "string", "format": "date-time" },
        "last_transition_at": { "type": "string", "format": "date-time" },
        "purged_at": { "type": "string", "format": "date-time" },
        "next_review_at": { "type": "string", "format": "date-time" },
        "disposition_event_ref": { "type": "string" }
      }
    }
  }
}
