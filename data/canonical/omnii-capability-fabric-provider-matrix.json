  "registry": "omnii-capability-fabric-provider-matrix",
  "status": "canonical-seed",
  "version": "1.0.0",
  "authority": "OMNII_CONTROL_PLANE_CANONICAL",
  "principle": "one canonical capability meaning with replaceable provider implementations",
