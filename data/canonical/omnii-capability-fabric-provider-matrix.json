  "routingRules": [
    "Prefer an existing canonical capability before creating a new one.",
    "Permit multiple providers for one canonical capability when their semantics are equivalent.",
    "Do not use provider status as constitutional authority.",
    "Do not promote external responses to Actual without verification and provenance.",
    "Do not route consequential mutations without the existing authority and mission gates."
  ]
