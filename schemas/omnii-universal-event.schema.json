{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omnii://schemas/universal-event/v1",
  "title": "OMNII Universal Event",
  "type": "object",
  "required": ["id", "type", "subject", "actor", "action", "occurred_at", "provenance"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "type": {"type":"string","minLength":1},
    "subject": {"type":"string","minLength":1},
    "object": {"type":"string"},
    "actor": {"type":"string","minLength":1},
    "principal": {"type":"string"},
    "authority": {"type":"object"},
    "delegation_chain": {"type":"array","items":{"type":"string"}},
    "intent": {"type":"object"},
    "action": {"type":"string","minLength":1},
    "occurred_at": {"type":"string","minLength":1},
    "context": {"type":"object"},
    "previous_state": {"type":"object"},
    "new_state": {"type":"object"},
    "result": {"type":"object"},
    "provenance": {"type":"object","required":["source"],"properties":{"source":{"type":"string"}},"additionalProperties":true},
    "evidence": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "liability": {"type":"object"},
    "settlement": {"type":"object"},
    "confidence": {"type":"number","minimum":0,"maximum":1},
    "metadata": {"type":"object"}
  },
  "additionalProperties": true
}