{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carbonactual.example/omnii/schemas/omnii-scope-taxonomy.schema.json",
  "title": "OMNII Scope Taxonomy",
  "description": "Machine-readable scope classification for historical, current, future, emerging and unknown/extraordinary objects and compositions.",
  "type": "object",
  "required": ["horizon", "architecturalClass", "type", "lifecycle", "provenance"],
  "properties": {
    "horizon": {"enum": ["OLD", "NOW", "FUTURE", "EMERGING", "UNKNOWN_ALIEN"]},
    "architecturalClass": {"enum": ["constitutional/core", "reusable capability", "domain module", "product", "institutional configuration", "integration adapter", "presentation", "reference/speculative"]},
    "type": {"type": "string", "minLength": 1},
    "lifecycle": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "required": ["sourceType"], "properties": {"sourceType": {"type": "string", "minLength": 1}, "sourceRef": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false},
    "authorityContext": {"type": "object"},
    "relationships": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "string"},
    "temporalValidity": {"type": "object"},
    "extensions": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"horizon": {"const": "UNKNOWN_ALIEN"}}}, "then": {"required": ["uncertainty", "provenance"]}},
    {"if": {"properties": {"horizon": {"enum": ["FUTURE", "EMERGING"]}}}, "then": {"required": ["temporalValidity", "provenance"]}}
  ],
  "additionalProperties": false
}
